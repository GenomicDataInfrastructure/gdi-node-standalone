{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetadataOverlay",
  "description": "A patch over a dataset's FDP-served metadata. Every field is optional: a field present\nin the JSON overwrites the baseline, an absent field is left untouched. Clearing a field\nback to absent is not supported. Re-edit with the desired value instead.",
  "type": "object",
  "properties": {
    "accessRights": {
      "description": "Access rights authority IRI (`PUBLIC` / `RESTRICTED` / `NON_PUBLIC`).",
      "type": [
        "string",
        "null"
      ]
    },
    "applicableLegislation": {
      "description": "Legislation mandating the dataset (EU ELI IRIs, >= 1).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "conformsTo": {
      "description": "Standards-compliance IRIs.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "http://data.gdi.eu/core/p2/ExternallyGoverned",
          "http://data.gdi.eu/core/p2/1MGCompliant",
          "http://data.gdi.eu/core/p2/1MGCohort"
        ]
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "contactPoint": {
      "description": "Who to write to about the dataset.",
      "anyOf": [
        {
          "$ref": "#/$defs/ContactPoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "description": "Creating agents (>= 1).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Agent"
      }
    },
    "description": {
      "description": "Free-text description (plain string or language map).",
      "anyOf": [
        {
          "$ref": "#/$defs/LocalizedText"
        },
        {
          "type": "null"
        }
      ]
    },
    "healthCategory": {
      "description": "GDI health category IRIs (>= 1).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "http://data.gdi.eu/core/p2/HealthCategoryHumanGenetic",
          "http://data.gdi.eu/core/p2/HealthCategoryHumanEpigenomic",
          "http://data.gdi.eu/core/p2/HealthCategoryHumanGenomic"
        ]
      },
      "maxItems": 3,
      "minItems": 1,
      "uniqueItems": true
    },
    "healthTheme": {
      "description": "Health themes: the disease or healthcare areas, as EU health-theme IRIs (recommended).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/ANTIMICROBIAL_CONTROL",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/BLOOD_INFECTIONS",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/CANCER_DISEASE",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/CLIMATE_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/EMERGENCY_SETTINGS",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/ENTERIC_INFECTIONS",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/ENVIRONMENTAL_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/HEALTH_PRODUCTS",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/HEALTH_SYSTEMS",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/IMMUNIZATION_DISEASES",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/INJURY_PREVENTION",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/LIFECOURSE_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/MENTAL_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NONCOMMUNICABLE_DISEASES",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NUTRITION_SECURITY",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/REPRODUCTIVE_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/RESPIRATORY_DISEASES",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/SENSORY_HEALTH",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/TROPICAL_DISEASES",
          "https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/VECTOR_DISEASES"
        ]
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "isReferencedBy": {
      "description": "Publication DOI IRIs.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "description": "Tags for discovery (recommended).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "legalBasis": {
      "description": "DPV legal basis IRIs (for real personal data).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "license": {
      "description": "Reuse license for this dataset (IRI).",
      "type": [
        "string",
        "null"
      ]
    },
    "maxTypicalAge": {
      "description": "Typical age of the oldest people in the dataset, in years.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 150,
      "minimum": 0
    },
    "minTypicalAge": {
      "description": "Typical age of the youngest people in the dataset, in years.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 150,
      "minimum": 0
    },
    "numberOfUniqueIndividuals": {
      "description": "Distinct sequenced subjects across the whole dataset (recommended).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "otherIdentifier": {
      "description": "Secondary identifiers.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/OtherIdentifier"
      }
    },
    "provenance": {
      "description": "How the data was produced (plain string or language map).",
      "anyOf": [
        {
          "$ref": "#/$defs/LocalizedText"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "description": "Dataset title (plain string or language map).",
      "anyOf": [
        {
          "$ref": "#/$defs/LocalizedText"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "description": "Dataset type IRIs, set only for synthetic datasets.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "https://publications.europa.eu/resource/authority/dataset-type/SYNTHETIC_DATA"
        ]
      },
      "maxItems": 1,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Agent": {
      "description": "An agent (creator / contributor). Maps to `foaf:Agent`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "`foaf:name`.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "ContactPoint": {
      "description": "A vCard-style contact point (`vcard:Kind`).",
      "type": "object",
      "properties": {
        "fn": {
          "description": "`vcard:fn` (required).",
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "hasEmail": {
          "description": "`vcard:hasEmail`, a `mailto:` IRI (required).",
          "type": "string",
          "maxLength": 254,
          "pattern": "^mailto:[^@<>\"{}|^`\\\\\\x00-\\x20]+@[^.<>\"{}|^`\\\\\\x00-\\x20]+\\.[^<>\"{}|^`\\\\\\x00-\\x20]+$"
        },
        "hasURL": {
          "description": "`vcard:hasURL` (optional; recommended sub-field).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fn",
        "hasEmail"
      ]
    },
    "LocalizedText": {
      "description": "Either a plain string or a BCP-47 language map (e.g. `{en: \"...\", et: \"...\"}`).\n\nUsed for the localized `title`, `description` and `provenance` fields.",
      "anyOf": [
        {
          "description": "Single untagged value.",
          "type": "string",
          "maxLength": 10000,
          "minLength": 1
        },
        {
          "description": "Language-tagged values, keyed by BCP-47 tag.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1
          },
          "maxProperties": 24,
          "minProperties": 1
        }
      ]
    },
    "OtherIdentifier": {
      "description": "A secondary identifier (`adms:identifier`).",
      "type": "object",
      "properties": {
        "name": {
          "description": "Optional human-readable name.",
          "type": [
            "string",
            "null"
          ]
        },
        "notation": {
          "description": "`skos:notation` (required within the identifier).",
          "type": "string"
        },
        "schemaAgency": {
          "description": "`adms:schemaAgency` (recommended within the identifier).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "notation"
      ]
    }
  }
}
