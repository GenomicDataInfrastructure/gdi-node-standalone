# Bring-your-own backends — copy to .env.external and fill every <SET ME: ...>.
#
#   cp .env.external.example .env.external
#   docker compose --env-file .env.external \
#     -f docker-compose.yml -f docker-compose.external.yml up -d
#
# `--env-file` supersedes the committed .env, whose COMPOSE_PROFILES would otherwise
# start the bundled dev backends you are replacing.
#
# Never commit the filled copy: it names your endpoints and may carry credentials.
# (.env.external is gitignored.)

# --- Your secrets backend (Vault or OpenBao — both speak the same KV v2 + Transit API)
GDI_VAULT_ADDR=<SET ME: https://vault.example.org>

# --- Your object store (any S3-compatible endpoint)
GDI_S3_ENDPOINT=<SET ME: https://s3.example.org>
GDI_S3_REGION=<SET ME: us-east-1>
GDI_S3_BUCKET=<SET ME: your-bucket-name>

# --- Your node.toml (host path; mounted read-only into the container)
GDI_NODE_CONFIG=<SET ME: /absolute/path/to/node.toml>

# --- Auth: export exactly one of these sets in your shell, not here, so credentials never
#     land in a file. See deployment.md, "Running against your own backends".
#
#   AppRole (typical for a long-running node):
#     export GDI_NODE__VAULT__ROLE_ID=...
#     export GDI_NODE__VAULT__SECRET_ID=...
#
#   Agent sidecar (credential-free; the agent authenticates and refreshes the file):
#     export GDI_NODE__VAULT__TOKEN_FILE=/run/secrets/vault/token
#     (also mount that path into the container)
#
#   Static token (simplest; it expires and the node does not renew it — operating.md §8):
#     export GDI_NODE__VAULT__TOKEN=...
